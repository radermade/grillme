{
  "name": "grillme",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "api:generate": "node scripts/openapi-contract.mjs",
    "api:check": "node scripts/openapi-contract.mjs --check && node scripts/openapi-runtime-examples.mjs",
    "api:mock": "node scripts/openapi-mock-server.mjs",
    "desktop:dev": "vite --config apps/desktop/vite.config.ts",
    "desktop:build": "vite build --config apps/desktop/vite.config.ts",
    "web:build": "vite build --config apps/web/vite.config.ts",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --no-bundle",
    "tauri:bundle": "tauri build",
    "tauri:bundle:macos": "tauri build --bundles app,dmg",
    "tauri:bundle:windows": "tauri build --bundles msi,nsis",
    "typecheck": "tsc --noEmit",
    "test": "npm run api:check && node tests/run.mjs",
    "prototype:dev": "vite prototypes/learning-loop/web",
    "prototype:build": "vite build prototypes/learning-loop/web",
    "test:prototype": "node --test prototypes/learning-loop/exercise/validator.test.mjs",
    "test:prototype:reference": "node --test prototypes/learning-loop/exercise/validator.reference.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@xstate/react": "6.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "xstate": "5.33.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  }
}