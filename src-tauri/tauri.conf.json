{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grill Me",
  "version": "0.1.0",
  "identifier": "com.grillme.desktop",
  "build": {
    "beforeDevCommand": "npm run desktop:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run desktop:build",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Grill Me",
      "width": 1180,
      "height": 760,
      "minWidth": 760,
      "minHeight": 560
    }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A hands-on study workspace"
  }
}