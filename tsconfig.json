{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@grillme/domain": ["./packages/domain/src/index.ts"],
      "@grillme/content": ["./packages/content/src/index.ts"],
      "@grillme/control-plane": ["./apps/control-plane/src/index.ts"],
      "@grillme/evaluation": ["./packages/evaluation/src/index.ts"],
      "@grillme/machines": ["./packages/machines/src/index.ts"],
      "@grillme/platform": ["./packages/platform/src/index.ts"],
      "@grillme/ui": ["./packages/ui/src/index.ts"],
      "@grillme/ui/*": ["./packages/ui/src/*"]
    }
  },
  "include": ["apps/control-plane/src/**/*.ts", "apps/desktop/src/**/*.ts", "apps/desktop/src/**/*.tsx", "apps/web/src/**/*.ts", "apps/web/src/**/*.tsx", "packages/**/*.ts", "prototypes/learning-loop/web/src/**/*.ts", "packages/ui/src/Workspace.tsx", "packages/ui/src/OperationsView.tsx", "packages/ui/src/GrillView.tsx", "packages/ui/src/TrainingView.tsx", "packages/ui/src/LabView.tsx", "packages/ui/src/ReadinessView.tsx", "packages/ui/src/ReviewView.tsx", "packages/ui/src/ErrorBoundary.tsx"]
}